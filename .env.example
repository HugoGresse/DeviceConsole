# Firebase web config (public by design - safe to expose in the client bundle)
VITE_APPID=
VITE_API_KEY=
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_DATABASE_URL=https://your-project.firebaseio.com
VITE_PROJECT_ID=your-project
VITE_MESSAGING_SENDER_ID=
VITE_VAPID_KEY=

# Optional: enables Firebase Analytics when set
VITE_MEASUREMENT_ID=

# Cloud Function endpoint (printed by `firebase deploy --only functions`)
VITE_NOTIFY_URL=https://us-central1-your-project.cloudfunctions.net/notify
