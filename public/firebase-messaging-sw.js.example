// Give the service worker access to Firebase Messaging.
// Only Firebase Messaging is available here; other Firebase libraries are not.
importScripts('https://www.gstatic.com/firebasejs/12.18.0/firebase-app-compat.js')
importScripts('https://www.gstatic.com/firebasejs/12.18.0/firebase-messaging-compat.js')

firebase.initializeApp({
    apiKey: "",
    authDomain: ".firebaseapp.com",
    databaseURL: ".firebaseio.com",
    projectId: "",
    storageBucket: ".appspot.com",
    messagingSenderId: "",
    appId: ""
})

self.addEventListener('notificationclick', function (event) {
    event.notification.close()
    // The FCM backend puts the target in fcm_options.link, but a cross-host link is not
    // handled by the Firebase JS client SDK, so it is resolved manually here.
    const url = event.notification?.data?.FCM_MSG?.notification?.click_action
    if (!url) return

    event.waitUntil(
        self.clients.matchAll({ type: 'window' }).then(windowClients => {
            for (const client of windowClients) {
                if (client.url === url && 'focus' in client) {
                    return client.focus()
                }
            }
            if (self.clients.openWindow) {
                return self.clients.openWindow(url)
            }
        })
    )
}, false)

firebase.messaging()
